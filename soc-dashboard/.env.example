# Copy to .env (never commit .env) and fill in real values.

# Wazuh API (manager) and Wazuh Indexer (OpenSearch)
WAZUH_URL=https://<wazuh-server-ip-or-host>
WAZUH_API_PORT=55000
WAZUH_USER=<wazuh-api-user>
WAZUH_PASS=<wazuh-api-password>
INDEXER_URL=https://<wazuh-server-ip-or-host>
INDEXER_PORT=9200
INDEXER_USER=<indexer-user>
INDEXER_PASS=<indexer-password>

# TLS: verified by default. Wazuh uses self-signed certs, so either point CA_BUNDLE
# at the Wazuh root CA (recommended) or set VERIFY_TLS=false for a throwaway lab only.
# CA_BUNDLE=/path/to/root-ca.pem
# VERIFY_TLS=false

# Groq API key for Llama 3.3 70B
GROQ_API_KEY=<your-groq-api-key>

# Dashboard access. Defaults to 127.0.0.1 only. To listen on any other address you
# MUST set DASHBOARD_PASS (HTTP Basic auth), otherwise the app refuses to start.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
# DASHBOARD_USER=analyst
# DASHBOARD_PASS=<long-random-password>

# Flask debugger (remote code execution risk). Honoured on loopback only.
# FLASK_DEBUG=false
